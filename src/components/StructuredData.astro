---
import { SITE } from "@/config";

export interface Props {
  type: "BlogPosting" | "Person" | "WebSite";
  data: any;
}

const { type, data } = Astro.props;

let structuredData = {};

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: {
      "@type": "Person",
      name: data.author || "Danny Garcia",
      url: "https://dannygarcia.net/about",
    },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: {
      "@type": "Person",
      name: "Danny Garcia",
      logo: {
        "@type": "ImageObject",
        url: "https://dannygarcia.net/icon-512.png",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || "https://dannygarcia.net/pfp_linkedin.jpeg",
    articleSection: data.tags?.[0] || "Technology",
    keywords: data.tags?.join(", ") || "",
    wordCount: data.wordCount,
    timeRequired: data.readingTime,
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Danny Garcia",
    url: "https://dannygarcia.net",
    image: "https://dannygarcia.net/pfp_linkedin.jpeg",
    sameAs: [
      "https://github.com/garcia-danny",
      "https://instagram.com/dannygvrcia"
    ],
    jobTitle: "College Student",
    description: SITE.desc,
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Danny Garcia",
    url: "https://dannygarcia.net",
    description: SITE.desc,
    author: {
      "@type": "Person",
      name: "Danny Garcia",
    },
    potentialAction: {
      "@type": "SearchAction",
      target: "https://dannygarcia.net/search?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />